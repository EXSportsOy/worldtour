{
  "hosting": [
    {
      "target": "worldtour",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/.*/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "*.py",
        "README.md",
        "i18n/**",
        "legal/**",
        "tools/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
          ]
        },
        {
          "source": "/assets/fonts/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/assets/img/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        }
      ]
    }
  ]
}
